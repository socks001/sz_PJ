---
const anchors = [
  { href: '#experience', label: '经历' },
  { href: '#stack', label: '技术栈' },
  { href: '#arch', label: '架构' },
  { href: '#motion', label: '动效' },
  { href: '#perf', label: '性能' },
  { href: '#contact', label: '联系' },
];

const email = '3211942168@qq.com';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="#top">SHU ZHAN</a>

    <nav class="nav-desktop" aria-label="主导航">
      <ul class="nav-list">
        {
          anchors.map((anchor) => (
            <li>
              <a href={anchor.href}>{anchor.label}</a>
            </li>
          ))
        }
      </ul>
      <a class="nav-email" href="mailto:3211942168@qq.com">{email}</a>
    </nav>

    <button
      class="menu-toggle"
      type="button"
      aria-label="打开导航菜单"
      aria-expanded="false"
      aria-controls="menu"
      data-menu-toggle
    >
      <span class="menu-line" aria-hidden="true"></span>
      <span class="menu-line" aria-hidden="true"></span>
    </button>
  </div>
</header>

<div id="menu" class="menu-overlay" role="dialog" aria-modal="true" aria-label="导航菜单" data-menu>
  <button class="menu-close" type="button" aria-label="关闭导航菜单" data-menu-close>关闭</button>

  <nav class="menu-nav" aria-label="移动端导航">
    <ul>
      {
        anchors.map((anchor) => (
          <li>
            <a href={anchor.href} data-menu-item>
              {anchor.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    padding-top: env(safe-area-inset-top);
    transition: transform var(--motion-nav-duration) var(--ease-out);
  }

  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-nav-scrim);
    backdrop-filter: blur(var(--layout-nav-blur));
    opacity: 0;
    transition: opacity var(--motion-nav-duration) var(--ease-out);
    pointer-events: none;
  }

  .site-header.is-scrolled::before {
    opacity: 1;
  }

  .site-header.is-hidden {
    transform: translateY(calc(-100% - env(safe-area-inset-top)));
  }

  .site-header.is-hidden:focus-within {
    transform: none;
  }

  .header-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--layout-nav-height);
  }

  .logo {
    font-size: var(--text-body-size);
    line-height: var(--text-body-leading);
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .nav-desktop {
    display: none;
  }

  .menu-toggle {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: var(--layout-tap-target);
    height: var(--layout-tap-target);
    margin-right: calc(var(--space-1) * -1);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .menu-line {
    width: var(--layout-menu-icon);
    height: var(--border-hairline);
    background: var(--color-text-primary);
  }

  .menu-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 20;
    padding-top: calc(var(--layout-nav-height) + env(safe-area-inset-top) + var(--space-3));
    padding-inline: var(--layout-gutter);
    background: var(--color-bg-base);
  }

  .menu-overlay.is-open {
    display: block;
  }

  .menu-close {
    position: absolute;
    top: calc(env(safe-area-inset-top) + var(--space-1));
    right: var(--layout-gutter);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--layout-tap-target);
    min-height: var(--layout-tap-target);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text-secondary);
    font-size: var(--text-caption-size);
    line-height: var(--text-caption-leading);
    cursor: pointer;
  }

  .menu-nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .menu-nav a {
    font-size: var(--text-menu-size);
    line-height: var(--text-menu-leading);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text-secondary);
    transition: color var(--motion-nav-active-duration) var(--ease-out);
  }

  .menu-nav a[aria-current] {
    color: var(--color-text-primary);
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .menu-toggle,
    .menu-overlay,
    .menu-overlay.is-open {
      display: none;
    }

    .nav-desktop {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .nav-list {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .nav-list a,
    .nav-email {
      color: var(--color-text-secondary);
      font-size: var(--text-caption-size);
      line-height: var(--text-caption-leading);
      transition: color var(--motion-nav-active-duration) var(--ease-out);
    }

    .nav-list a[aria-current],
    .nav-email:hover {
      color: var(--color-text-primary);
    }

    .nav-email {
      font-family: ui-monospace, 'SF Mono', 'Roboto Mono', Menlo, Consolas, monospace;
    }
  }
</style>
