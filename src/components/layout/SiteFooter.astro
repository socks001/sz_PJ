---
import build from '../../data/build.json';
---

<footer class="site-footer" data-reveal="footer">
  <div class="container footer-inner">
    <div class="footer-info">
      <p>© 2026 舒展</p>
      <p>版本 {build.version} · 构建时间 {build.builtAt}</p>
    </div>

    <a class="to-top" href="#top" aria-label="回到顶部" data-to-top>
      <span aria-hidden="true">↑</span>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-hairline) solid var(--color-border-subtle);
  }

  .footer-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-3);
    padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom));
  }

  .footer-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    color: var(--color-text-tertiary);
    font-size: var(--text-caption-size);
    line-height: var(--text-caption-leading);
  }

  .to-top {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--layout-tap-target);
    height: var(--layout-tap-target);
    color: var(--color-text-secondary);
    font-size: var(--layout-icon-size);
    line-height: 1;
    transition:
      opacity var(--duration-feedback) ease,
      color var(--motion-hover-duration) var(--ease-out);
  }

  .to-top:active {
    opacity: 0.6;
  }

  .to-top[hidden] {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .to-top:hover {
      color: var(--color-text-primary);
    }
  }
</style>
