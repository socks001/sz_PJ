---
interface Props {
  number: string;
  name: string;
}

const { number, name } = Astro.props;
---

<div class="demo" data-demo={number} role="group" aria-label={`${name}的微缩演示`}>
  <div class="demo-stage" aria-hidden="true">
    {
      number === '01' && (
        <div class="stage stage-hero">
          <span class="bar bar-eyebrow" data-step="eyebrow" />
          <span class="bar bar-title" data-step="l1" />
          <span class="bar bar-title bar-title--short" data-step="l2" />
          <span class="bar bar-lede" data-step="lede" />
          <span class="bar bar-button" data-step="actions" />
          <span class="stage-caption mono">0 → 1200ms</span>
        </div>
      )
    }

    {
      number === '02' && (
        <div class="stage stage-parallax">
          <span class="para-glow" data-para-glow />
          <div class="para-card" data-para-card>
            <span class="bar bar-title" />
            <span class="bar bar-lede" />
          </div>
          <span class="stage-caption mono">scroll 0 → 100%</span>
        </div>
      )
    }

    {
      number === '03' && (
        <div class="stage stage-shared">
          <div class="shared-small" data-shared-small>
            <span class="shared-chip">卡片</span>
          </div>
          <div class="shared-large" data-shared-large />
          <div class="shared-ghost" data-shared-ghost>
            <span class="shared-chip">卡片</span>
          </div>
          <span class="stage-caption mono">click · FLIP</span>
        </div>
      )
    }

    {
      number === '04' && (
        <div class="stage stage-reduce">
          <div class="lane">
            <span class="lane-name mono">当前路径</span>
            <span class="lane-track">
              <span class="lane-dot" data-lane="current" />
            </span>
          </div>
          <div class="lane">
            <span class="lane-name mono">减弱路径</span>
            <span class="lane-track">
              <span class="lane-dot" data-lane="reduced" />
            </span>
          </div>
          <span class="stage-caption mono">位移 / 仅淡入</span>
        </div>
      )
    }

    {
      number === '05' && (
        <div class="stage stage-nav">
          <div class="mini-nav" data-mini-nav>
            <span class="mini-nav-scrim" data-mini-nav-scrim />
            <span class="mini-logo" />
            <span class="mini-links">
              <i />
              <i />
              <i />
            </span>
          </div>
          <div class="mini-body">
            <span class="bar bar-title" />
            <span class="bar bar-lede" />
            <span class="bar bar-lede bar-lede--short" />
          </div>
          <span class="stage-caption mono">↓120px 隐藏 · ↑40px 恢复</span>
        </div>
      )
    }
  </div>

  <button class="demo-replay" type="button" data-replay aria-label={`重播：${name}`}>
    <svg class="demo-play" viewBox="0 0 20 20" aria-hidden="true">
      <path
        d="M6.9 3.9v12.2a.7.7 0 0 0 1.07.6l9.1-6.1a.7.7 0 0 0 0-1.2l-9.1-6.1a.7.7 0 0 0-1.07.6Z"
        fill="currentColor"></path>
    </svg>
  </button>
</div>

<style>
  .demo {
    position: relative;
    aspect-ratio: var(--layout-demo-aspect);
    overflow: hidden;
    background: var(--color-bg-elevated);
    border: var(--border-hairline) solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    cursor: pointer;
    transition:
      border-color var(--motion-hover-duration) var(--ease-out),
      transform var(--duration-feedback) ease;
  }

  .demo:active {
    transform: scale(0.99);
  }

  .demo-stage {
    position: absolute;
    inset: 0;
  }

  .stage {
    position: absolute;
    inset: 0;
  }

  .bar {
    display: block;
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--color-border-strong);
  }

  .bar-eyebrow {
    width: 24%;
    height: 4px;
    background: var(--color-text-tertiary);
  }

  .bar-title {
    width: 72%;
    height: 12px;
    background: var(--color-text-primary);
    opacity: 0.86;
  }

  .bar-title--short {
    width: 56%;
    background: var(--color-text-secondary);
    opacity: 1;
  }

  .bar-lede {
    width: 82%;
    height: 4px;
    background: var(--color-text-tertiary);
  }

  .bar-lede--short {
    width: 58%;
  }

  .bar-button {
    width: 56px;
    height: 20px;
    margin-top: var(--space-1);
    background: var(--color-accent);
  }

  .stage-caption {
    position: absolute;
    bottom: var(--space-2);
    left: var(--space-2);
    color: var(--color-text-tertiary);
    font-size: var(--text-eyebrow-size);
    line-height: var(--text-eyebrow-leading);
    letter-spacing: 0.08em;
  }

  /* 01 首屏编排序列 */
  .stage-hero {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-3) var(--space-5);
  }

  .stage-hero .bar-lede {
    margin-top: var(--space-1);
  }

  .stage-hero .bar-button {
    margin-top: var(--space-2);
  }

  /* 02 滚动视差与纵深 */
  .stage-parallax {
    overflow: hidden;
  }

  .para-glow {
    position: absolute;
    top: -24%;
    right: -10%;
    width: 62%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-glow), transparent 65%);
  }

  .para-card {
    position: absolute;
    top: 30%;
    left: 10%;
    display: grid;
    gap: var(--space-1);
    width: 46%;
    padding: var(--space-2);
    border: var(--border-hairline) solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    background: var(--color-bg-base);
  }

  .para-card .bar-title {
    width: 78%;
    height: 8px;
  }

  /* 03 共享元素转场 */
  .stage-shared {
    overflow: hidden;
  }

  .shared-small {
    position: absolute;
    top: 16%;
    left: 8%;
    display: grid;
    place-items: center;
    width: 26%;
    height: 32%;
    border: var(--border-hairline) solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    background: var(--color-bg-base);
  }

  .shared-large {
    position: absolute;
    top: 12%;
    left: 40%;
    width: 52%;
    height: 66%;
    border: var(--border-hairline) dashed var(--color-border-subtle);
    border-radius: var(--radius-card);
  }

  .shared-ghost {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    border: var(--border-hairline) solid var(--color-border-strong);
    border-radius: var(--radius-card);
    background: var(--color-bg-base);
    opacity: 0;
    transform-origin: top left;
    pointer-events: none;
  }

  .shared-chip {
    color: var(--color-text-secondary);
    font-size: var(--text-caption-size);
    line-height: 1;
  }

  /* 04 减弱动效降级 */
  .stage-reduce {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-3);
  }

  .lane {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .lane-name {
    flex: none;
    width: 72px;
    color: var(--color-text-tertiary);
    font-size: var(--text-eyebrow-size);
    line-height: var(--text-eyebrow-leading);
    letter-spacing: 0.08em;
  }

  .lane-track {
    position: relative;
    flex: 1;
    height: 40px;
    border-bottom: var(--border-hairline) solid var(--color-border-subtle);
  }

  .lane-dot {
    position: absolute;
    bottom: var(--space-1);
    left: 8%;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-text-primary);
  }

  /* 05 导航随滚动显隐 */
  .stage-nav {
    overflow: hidden;
    background: var(--color-bg-base);
  }

  .mini-nav {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: 32px;
    padding-inline: var(--space-2);
  }

  .mini-nav-scrim {
    position: absolute;
    inset: 0;
    background: var(--color-nav-scrim);
    border-bottom: var(--border-hairline) solid var(--color-border-subtle);
    opacity: 0;
  }

  .mini-logo,
  .mini-links {
    position: relative;
  }

  .mini-logo {
    width: 28px;
    height: 4px;
    border-radius: var(--radius-pill);
    background: var(--color-text-primary);
  }

  .mini-links {
    display: flex;
    gap: var(--space-1);
    margin-left: auto;
  }

  .mini-links i {
    width: 14px;
    height: 3px;
    border-radius: var(--radius-pill);
    background: var(--color-text-tertiary);
  }

  .mini-body {
    position: absolute;
    top: 48px;
    right: var(--space-3);
    left: var(--space-3);
    display: grid;
    gap: var(--space-1);
  }

  /* 重播按钮：44×44，右下角内 12px */
  .demo-replay {
    position: absolute;
    right: var(--layout-demo-inset);
    bottom: var(--layout-demo-inset);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--layout-tap-target);
    height: var(--layout-tap-target);
    padding: 0;
    border: var(--border-hairline) solid var(--color-border-strong);
    border-radius: 50%;
    background: var(--color-bg-base);
    color: var(--color-text-primary);
    cursor: pointer;
  }

  .demo-play {
    width: var(--layout-demo-icon);
    height: var(--layout-demo-icon);
    opacity: 0.6;
    transition: opacity var(--motion-hover-duration) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .demo:hover,
    .demo:focus-within {
      border-color: var(--color-border-strong);
    }

    .demo:hover .demo-play,
    .demo:focus-within .demo-play {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo:active {
      transform: none;
    }

    .demo-play {
      transition: none;
    }
  }
</style>
