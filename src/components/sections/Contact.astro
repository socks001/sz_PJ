---
import SectionHeader from '../ui/SectionHeader.astro';
---

<section id="contact" class="section contact">
  <div class="container">
    <div class="contact-inner">
      <div data-reveal="title">
        <SectionHeader eyebrow="CONTACT" title="聊聊技术，或者给我一个机会。" />
      </div>
      <p class="status">求职中 · 前端开发</p>
      <button
        class="email"
        type="button"
        data-copy-email="3211942168@qq.com"
        aria-label="复制邮箱地址 3211942168@qq.com"
      >
        3211942168@qq.com
      </button>
      <p class="note">通常 1 个工作日内回复</p>

      <div class="actions">
        <a class="button" href="mailto:3211942168@qq.com">发送邮件</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-bottom: var(--space-6);
  }

  .contact-inner {
    max-width: var(--layout-contact-max);
  }

  .status {
    margin-top: var(--space-2);
    color: var(--color-text-secondary);
    font-size: var(--text-caption-size);
    line-height: var(--text-caption-leading);
  }

  .email {
    position: relative;
    display: inline-block;
    margin-top: var(--space-3);
    padding: 0;
    border: 0;
    background: none;
    font-size: var(--text-email-size);
    line-height: var(--text-email-leading);
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    transition: opacity var(--duration-feedback) ease;
  }

  .email::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -2px;
    left: 0;
    height: var(--border-hairline);
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--motion-hover-duration) var(--ease-out);
  }

  .email:active {
    opacity: 0.6;
  }

  @media (hover: hover) and (pointer: fine) {
    .email:hover::after {
      transform: scaleX(1);
    }
  }

  .note {
    margin-top: var(--space-1);
    color: var(--color-text-tertiary);
    font-size: var(--text-caption-size);
    line-height: var(--text-caption-leading);
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--layout-button-gap);
    margin-top: var(--space-5);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--layout-control-height);
    padding-inline: var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-bg-base);
    font-size: var(--text-body-size);
    font-weight: 600;
  }

  @media (min-width: 1024px) {
    .actions {
      flex-direction: row;
      align-items: center;
    }
  }
</style>
