---
const tags = ['Vue 3', 'TypeScript', 'Vite', 'Pinia', 'ECharts'];
---

<section id="top" class="hero">
  <div class="glow-layer" data-hero data-hero-parallax aria-hidden="true">
    <div class="glow" data-hero-glow></div>
  </div>
  <div class="fade" aria-hidden="true"></div>

  <div class="container hero-content" data-hero-content>
    <p class="eyebrow" data-hero>FRONT-END · 2026 GRAD</p>

    <h1 class="title">
      <span data-hero>舒展的技术样本</span>
      <span class="title-secondary" data-hero>从设计到部署</span>
    </h1>

    <p class="lede" data-hero>
      2026 届计算机科学与技术，专注 Vue 3；本页设计、动效、构建与发布由我独立完成。
    </p>

    <ul class="tags" aria-label="技术标签" data-hero>
      {
        tags.map((tag) => (
          <li>{tag}</li>
        ))
      }
    </ul>

    <div class="actions" data-hero>
      <a class="button-primary" href="#stack">看实现</a>
    </div>

    <p class="scroll-hint" data-hero data-scroll-hint>
      <span>SCROLL</span>
      <span class="scroll-line" aria-hidden="true"></span>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100dvh;
    padding-top: calc(var(--layout-nav-height) + env(safe-area-inset-top));
    padding-bottom: var(--space-7);
    overflow: clip;
  }

  .glow-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .glow {
    position: absolute;
    inset: -20% -20% auto;
    height: 72%;
    background: radial-gradient(ellipse at 70% 22%, var(--color-glow), transparent 60%);
    pointer-events: none;
  }

  .fade {
    position: absolute;
    inset: auto 0 0;
    height: 40%;
    background: linear-gradient(to bottom, transparent, var(--color-bg-base));
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .title {
    font-size: var(--text-display-size);
    line-height: var(--text-display-leading);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .title span {
    display: block;
  }

  .title-secondary {
    color: var(--color-text-secondary);
  }

  .lede {
    max-width: 34em;
    margin-top: var(--space-2);
    color: var(--color-text-secondary);
    font-size: var(--text-body-size);
    line-height: var(--text-body-leading);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) 0;
    margin-top: var(--space-3);
    font-family: ui-monospace, 'SF Mono', 'Roboto Mono', Menlo, Consolas, monospace;
    font-size: var(--text-mono-size);
    line-height: var(--text-mono-leading);
    color: var(--color-text-secondary);
  }

  .tags li:not(:first-child)::before {
    content: '·';
    margin-inline: var(--layout-tag-gap);
    color: var(--color-text-tertiary);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .button-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--layout-control-height);
    padding-inline: var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-bg-base);
    font-size: var(--text-body-size);
    font-weight: 600;
  }

  .scroll-hint {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    margin-top: var(--space-5);
    opacity: 0.5;
    font-family: ui-monospace, 'SF Mono', 'Roboto Mono', Menlo, Consolas, monospace;
    font-size: var(--text-caption-size);
    line-height: var(--text-caption-leading);
    letter-spacing: 0.12em;
    color: var(--color-text-tertiary);
  }

  .scroll-line {
    width: var(--border-hairline);
    height: var(--layout-scroll-line);
    background: var(--color-text-tertiary);
  }
</style>
