---
import SectionHeader from '../ui/SectionHeader.astro';

interface MatrixRow {
  platform: string;
  version: string;
  note: string;
}

interface Degradation {
  scene: string;
  behavior: string;
}

interface A11yItem {
  name: string;
  criterion: string;
}

const matrix: MatrixRow[] = [
  { platform: 'iOS Safari', version: '16.0', note: 'dvh、背景模糊、WAAPI' },
  { platform: 'Android Chrome', version: '108', note: '同上；地址栏收起时 dvh 生效' },
  { platform: '桌面 Chrome', version: '108', note: '背景模糊与指针视差' },
  { platform: '桌面 Edge', version: '108', note: '与 Chrome 同内核' },
  { platform: '桌面 Safari', version: '16.0', note: '背景模糊需 -webkit 前缀兜底' },
  { platform: 'Firefox', version: '104', note: '不使用 :has()，避免抬高门槛' },
];

const degradations: Degradation[] = [
  { scene: '不支持背景模糊', behavior: '导航退化为 88% 不透明底色' },
  { scene: '无精确指针（触摸设备）', behavior: '所有 hover 效果关闭，改用按压反馈' },
  {
    scene: '开启减弱动效',
    behavior: '位移、视差、缩放、循环动画全部关闭，仅保留 ≤ 200ms 透明度过渡',
  },
];

const a11yItems: A11yItem[] = [
  {
    name: '文本对比度',
    criterion: '实测最低值 ≥ 4.5:1；按令牌计算为 18.3 / 7.6 / 4.0:1（主 / 次 / 三级，对底色）',
  },
  { name: '键盘可达与焦点可见', criterion: '全部可交互元素可 Tab 到达，焦点环 2px 且可见' },
  { name: '点击热区 ≥ 44 × 44px', criterion: '逐项测量，无例外' },
  { name: '200% 文字缩放不破版', criterion: '无横向滚动、无标题截断' },
  {
    name: '读屏语义（标题层级、替代文本）',
    criterion: '1 个页面级标题，层级不跳级，内容图有替代文本',
  },
  { name: '减弱动效响应', criterion: '按 §5.5 全部生效' },
];
---

<section id="a11y" class="section">
  <div class="container">
    <SectionHeader
      eyebrow="COMPATIBILITY"
      title="兼容与可访问性"
      description="矩阵与清单均为构建前基线，未实测前不标记为已支持。"
    />

    <div class="layout">
      <div class="left">
        <h3 class="block-title">兼容矩阵</h3>

        <ul class="matrix-list" data-reveal="check">
          {
            matrix.map((row) => (
              <li class="matrix-row" data-reveal-item>
                <div class="matrix-head">
                  <span class="matrix-platform">{row.platform}</span>
                  <span class="matrix-version mono">{row.version}</span>
                  <span class="matrix-status">
                    <span class="status-dot" aria-hidden="true"></span>
                    未测试
                  </span>
                </div>
                <p class="matrix-note">{row.note}</p>
              </li>
            ))
          }
        </ul>

        <table class="matrix-table" data-reveal="check">
          <thead>
            <tr>
              <th scope="col">平台 / 浏览器</th>
              <th scope="col">目标最低版本</th>
              <th scope="col">状态</th>
              <th scope="col">备注</th>
            </tr>
          </thead>
          <tbody>
            {
              matrix.map((row) => (
                <tr data-reveal-item>
                  <th scope="row">{row.platform}</th>
                  <td class="mono">{row.version}</td>
                  <td>
                    <span class="status-dot" aria-hidden="true"></span>
                    未测试
                  </td>
                  <td>{row.note}</td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <h3 class="block-title">降级策略</h3>
        <ul class="degradations" data-reveal="check">
          {
            degradations.map((item) => (
              <li class="degradation" data-reveal-item>
                <p class="degradation-scene">{item.scene}</p>
                <p class="degradation-behavior">{item.behavior}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="right">
        <h3 class="block-title">可访问性清单</h3>
        <ul class="a11y-list" data-reveal="check">
          {
            a11yItems.map((item) => (
              <li class="a11y-item" data-reveal-item>
                <div class="a11y-head">
                  <span class="a11y-name">{item.name}</span>
                  <span class="a11y-status">
                    <span class="status-dot" aria-hidden="true"></span>
                    未测试
                  </span>
                </div>
                <p class="a11y-criterion">{item.criterion}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .layout {
    margin-top: var(--layout-section-header-gap);
  }

  .block-title {
    margin-top: var(--space-7);
    font-size: var(--text-h3-size);
    line-height: var(--text-h3-leading);
    font-weight: 600;
  }

  .left > .block-title:first-child,
  .right > .block-title:first-child {
    margin-top: 0;
  }

  .matrix-list {
    margin-top: var(--space-2);
  }

  .matrix-row {
    min-height: var(--layout-matrix-row-min);
    padding-block: var(--space-2);
    border-bottom: var(--border-hairline) solid var(--color-border-subtle);
  }

  .matrix-row:first-child {
    border-top: var(--border-hairline) solid var(--color-border-subtle);
  }

  .matrix-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
  }

  .matrix-platform {
    font-size: var(--text-body-size);
    line-height: var(--text-body-leading);
    font-weight: 500;
  }

  .matrix-version {
    color: var(--color-text-secondary);
  }

  .matrix-status,
  .a11y-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-text-secondary);
    font-size: var(--text-caption-size);
    line-height: var(--text-caption-leading);
  }

  .matrix-status {
    margin-left: auto;
  }

  .matrix-note {
    margin-top: var(--space-1);
    color: var(--color-text-tertiary);
    font-size: var(--text-caption-size);
    line-height: var(--text-caption-leading);
  }

  .matrix-table {
    display: none;
  }

  .degradations {
    margin-top: var(--space-2);
  }

  .degradation {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-block: var(--space-2);
    border-bottom: var(--border-hairline) solid var(--color-border-subtle);
  }

  .degradation-scene {
    font-size: var(--text-body-size);
    line-height: var(--text-body-leading);
    font-weight: 500;
  }

  .degradation-behavior {
    color: var(--color-text-secondary);
    font-size: var(--text-caption-size);
    line-height: var(--text-caption-leading);
  }

  .a11y-list {
    margin-top: var(--space-2);
  }

  .a11y-item {
    padding-block: var(--space-2);
    border-bottom: var(--border-hairline) solid var(--color-border-subtle);
  }

  .a11y-item:first-child {
    border-top: var(--border-hairline) solid var(--color-border-subtle);
  }

  .a11y-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
  }

  .a11y-name {
    font-size: var(--text-body-size);
    line-height: var(--text-body-leading);
    font-weight: 500;
  }

  .a11y-status {
    margin-left: auto;
  }

  .a11y-criterion {
    margin-top: var(--space-1);
    color: var(--color-text-secondary);
    font-size: var(--text-caption-size);
    line-height: var(--text-caption-leading);
  }

  @media (min-width: 768px) {
    .layout {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
  }

  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: 56fr 44fr;
    }

    .matrix-list {
      display: none;
    }

    .matrix-table {
      display: table;
      width: 100%;
      margin-top: var(--space-3);
      border-collapse: collapse;
      text-align: left;
      font-size: var(--text-body-size);
      line-height: var(--text-body-leading);
    }

    .matrix-table th,
    .matrix-table td {
      height: var(--layout-matrix-row-min);
      padding: var(--space-2) var(--space-2) var(--space-2) 0;
      vertical-align: middle;
      font-weight: 400;
    }

    .matrix-table thead th {
      height: auto;
      padding-block: var(--space-1);
      border-bottom: var(--border-hairline) solid var(--color-border-subtle);
      color: var(--color-text-tertiary);
      font-size: var(--text-caption-size);
      line-height: var(--text-caption-leading);
    }

    .matrix-table tbody tr {
      border-bottom: var(--border-hairline) solid var(--color-border-subtle);
    }

    .matrix-table tbody th {
      font-weight: 500;
    }

    .matrix-table tbody td {
      color: var(--color-text-secondary);
    }

    .matrix-table td:last-child,
    .matrix-table th:last-child {
      padding-right: 0;
    }
  }
</style>
